# Server origin used for redirects and same-origin mutation checks.
APP_ORIGIN=http://127.0.0.1:3000

# From the explicitly selected Supabase development project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supavisor transaction pool URI (port 6543).
DATABASE_URL=
# Optional PEM root certificate when the selected database needs a custom CA.
# Newlines can be represented as literal \n sequences. TLS verification stays enabled.
DATABASE_SSL_CA=

# Local CLI/CI only. Never expose these through NEXT_PUBLIC_ or browser responses.
# DIRECT_DATABASE_URL uses the direct/session endpoint (port 5432), not transaction pooling.
DIRECT_DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# Optional development QA provisioning only; the web app does not need an admin key.
SUPABASE_SECRET_KEY=

# Migration commands, only after confirming the selected development project:
# node --env-file=.env.local supabase/apply-migrations.mjs --project-ref <selected-project-ref>
# node --env-file=.env.local supabase/apply-migrations.mjs --project-ref <selected-project-ref> --apply
# The runner keeps checksummed history and refuses an untracked existing schema.
# Never reset a hosted project with user data.
# Configure email templates and a real SMTP sender before public signup/recovery.
